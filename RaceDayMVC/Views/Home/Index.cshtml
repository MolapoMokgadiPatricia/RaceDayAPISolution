@model EventListVm
@inject IWebHostEnvironment Env
@{
    ViewData["Title"] = "Your next finish line";
    string role = Context.Session.GetString(SessionKeys.Role) ?? string.Empty;
    bool hasPhoto = !string.IsNullOrEmpty(Env.WebRootPath) && System.IO.File.Exists(System.IO.Path.Combine(Env.WebRootPath, "img", "images.jpg"));
}

<section class="hero">
    @if (hasPhoto)
    {
        <div class="hero__photo" style="background-image: url('@Url.Content("~/img/images.jpg")')" aria-hidden="true"></div>
    }
    <div class="hero__shape hero__shape--band" aria-hidden="true"></div>
    <div class="hero__shape hero__shape--cream" aria-hidden="true"></div>
    <div class="container rd-container hero__inner">
        <h1 class="hero__title">Find your next <em>finish line</em></h1>
        <p class="hero__lead">RaceDay brings South Africa's road running, walking and cycling events into one place.</p>
        <div class="hero__actions">
            @if (role == "Participant")
            {
                <a class="btn rd-btn rd-btn--primary rd-btn--lg" href="#events">Find a race</a>
                <a class="btn rd-btn rd-btn--outline rd-btn--lg" asp-controller="Participant" asp-action="MyEvents">My events</a>
            }
            else if (role == "Organiser")
            {
                <a class="btn rd-btn rd-btn--primary rd-btn--lg" asp-controller="Organiser" asp-action="Dashboard">Go to dashboard</a>
                <a class="btn rd-btn rd-btn--outline rd-btn--lg" asp-controller="Organiser" asp-action="CreateEvent">Create an event</a>
            }
            else
            {
                <a class="btn rd-btn rd-btn--primary rd-btn--lg" asp-controller="Account" asp-action="Register">Create a free account</a>
                <a class="btn rd-btn rd-btn--outline rd-btn--lg" href="#events">Our events</a>
            }
        </div>
    </div>
</section>

<section class="section" id="events">
    <div class="container rd-container">
        <div class="section__head">
            <h2 class="section__title">Upcoming events</h2>
            <p class="section__lead">Filter by distance, type or town and open any race to see its categories.</p>
        </div>
        <partial name="_EventBrowser" model="Model" />
    </div>
</section>

<section class="section about" id="about">
    <div class="container rd-container">
        <div class="row align-items-center g-5">
            <div class="col-md-6"><div class="about__shape" aria-hidden="true"></div></div>
            <div class="col-md-6">
                <h2 class="section__title about__title">About RaceDay</h2>
                <p class="about__text">
                    South Africa has a rich road events culture, from the Comrades Marathon to the Cape Town Cycle Tour and hundreds of community walks every weekend.
                    RaceDay replaces paper forms and spreadsheets with one place where organisers run their events and participants take part.
                </p>
                <ul class="about__points">
                    <li>Organisers create events, set up categories, confirm entries and publish results.</li>
                    <li>Participants browse races, enter in a few taps and keep their personal race history.</li>
                </ul>
                @if (string.IsNullOrEmpty(role))
                {
                    <a class="btn rd-btn rd-btn--primary" asp-controller="Account" asp-action="Register">Become a member</a>
                }
            </div>
        </div>
    </div>
</section>

<section class="section section--dark">
    <div class="container rd-container">
        <h2 class="section__title section__title--light">How RaceDay works</h2>
        <ol class="steps">
            <li class="step">
                <span class="step__num">1</span>
                <h3>Pick a race</h3>
                <p>Browse road runs, walks and cycle tours across the country and compare distances and categories.</p>
            </li>
            <li class="step">
                <span class="step__num">2</span>
                <h3>Enter in a few taps</h3>
                <p>Choose the category that suits your age or distance. The organiser confirms your place.</p>
            </li>
            <li class="step">
                <span class="step__num">3</span>
                <h3>Track every finish</h3>
                <p>Organisers publish finish times and positions, and they appear in your personal race history.</p>
            </li>
        </ol>
    </div>
</section>
