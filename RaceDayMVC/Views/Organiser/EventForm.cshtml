@model EventFormVm
@{
    bool editing = Model.EventId > 0;
    ViewData["Title"] = editing ? "Edit event" : "Create event";
    string? current = UiHelpers.SafeImage(Model.BannerImageUrl);
}
<section class="page-head">
    <div class="container rd-container">
        <a class="back-link back-link--dark" asp-action="Events">My events</a>
        <h1 class="page-title">@(editing ? "Edit event" : "Create an event")</h1>
        <p class="page-lead">@(editing ? "Change the details below. Participants see updates straight away." : "Add the details participants need to decide on entering.")</p>
    </div>
</section>

<section class="section section--tight">
    <div class="container rd-container">
        <form method="post" enctype="multipart/form-data" asp-action="@(editing ? "EditEvent" : "CreateEvent")" asp-route-id="@(editing ? Model.EventId.ToString() : null)" data-validate>
            <div asp-validation-summary="ModelOnly" class="form-error-box"></div>
            <input type="hidden" asp-for="BannerImageUrl" />
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="panel">
                        <h2 class="panel__title">Event details</h2>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label rd-label">Event name</label>
                                <input asp-for="Name" class="form-control rd-input" maxlength="100" required placeholder="e.g. Soweto Marathon" />
                                <span asp-validation-for="Name" class="field-error"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Description" class="form-label rd-label">Description</label>
                                <textarea asp-for="Description" class="form-control rd-input" rows="5" maxlength="500" data-counter="#descCount" placeholder="Route highlights, start time, what to bring"></textarea>
                                <div class="d-flex justify-content-between">
                                    <span asp-validation-for="Description" class="field-error"></span>
                                    <small class="field-hint ms-auto"><span id="descCount">0</span> / 500</small>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="EventDate" class="form-label rd-label">Date</label>
                                <input asp-for="EventDate" type="date" class="form-control rd-input" value="@(Model.EventDate?.ToString("yyyy-MM-dd"))" required />
                                <span asp-validation-for="EventDate" class="field-error"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="Location" class="form-label rd-label">Location</label>
                                <input asp-for="Location" class="form-control rd-input" maxlength="100" required placeholder="Town or venue" />
                                <span asp-validation-for="Location" class="field-error"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="DistanceKm" class="form-label rd-label">Distance (km)</label>
                                <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" max="999.99" class="form-control rd-input" required />
                                <span asp-validation-for="DistanceKm" class="field-error"></span>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label rd-label" id="typeLabel">Event type</label>
                                <div class="type-picker" role="radiogroup" aria-labelledby="typeLabel">
                                    @foreach (var t in new[] { "run", "walk", "cycle" })
                                    {
                                        <label class="type-chip">
                                            <input type="radio" asp-for="EventType" value="@t" />
                                            <span>@UiHelpers.TypeLabel(t)</span>
                                        </label>
                                    }
                                </div>
                                <span asp-validation-for="EventType" class="field-error"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="panel">
                        <h2 class="panel__title">Banner image</h2>
                        <div class="banner-preview">
                            <img id="bannerPreview" src="@(current ?? "")" alt="Banner preview" @(current == null ? "hidden" : "") />
                            <span id="bannerEmpty" class="banner-preview__empty" @(current != null ? "hidden" : "")>No banner yet</span>
                        </div>
                        <label for="Banner" class="btn rd-btn rd-btn--outline-dark w-100 mt-3">@(current == null ? "Choose an image" : "Replace image")</label>
                        <input type="file" asp-for="Banner" class="visually-hidden" accept="image/png,image/jpeg,image/webp,image/gif"
                               data-image-input data-preview="#bannerPreview" data-hide="#bannerEmpty" data-max-mb="5" />
                        <p class="file-note" data-file-note>JPG, PNG, WEBP or GIF, up to 5 MB. Wide images (3:1) look best.</p>
                        <span asp-validation-for="Banner" class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn rd-btn rd-btn--primary rd-btn--lg" data-submit-label="Saving...">@(editing ? "Save changes" : "Create event")</button>
                <a class="btn rd-btn rd-btn--outline-dark rd-btn--lg" asp-action="Events">Cancel</a>
            </div>
        </form>
    </div>
</section>
