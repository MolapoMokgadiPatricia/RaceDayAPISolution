@model List<DashboardEventRow>
@{
    ViewData["Title"] = "My events";
}
<section class="page-head">
    <div class="container rd-container d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <h1 class="page-title">My events</h1>
            <p class="page-lead">Create, edit and remove the events you organise.</p>
        </div>
        <a class="btn rd-btn rd-btn--primary rd-btn--lg" asp-action="CreateEvent">Create an event</a>
    </div>
</section>

<section class="section section--tight">
    <div class="container rd-container">
        @if (!Model.Any())
        {
            <partial name="_NoEvents" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table rd-table">
                    <thead>
                        <tr><th>Banner</th><th>Event</th><th>Date</th><th>Type</th><th>Distance</th><th>Enrolments</th><th class="text-end">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            string? img = UiHelpers.SafeImage(r.Event.BannerImageUrl);
                            <tr class="@(r.IsPast ? "row-past" : "")">
                                <td data-label="Banner">
                                    @if (img != null) { <img class="thumb" src="@img" alt="" loading="lazy" /> }
                                    else { <span class="thumb thumb--empty type-@r.Event.EventType.ToLowerInvariant()">@UiHelpers.TypeLabel(r.Event.EventType)</span> }
                                </td>
                                <td data-label="Event">
                                    <a class="table-link" asp-controller="Events" asp-action="Details" asp-route-id="@r.Event.EventID">@r.Event.Name</a>
                                    <small class="d-block text-muted-rd">@r.Event.Location</small>
                                </td>
                                <td data-label="Date">@r.Event.EventDate.ToString("d MMM yyyy")</td>
                                <td data-label="Type">@UiHelpers.TypeLabel(r.Event.EventType)</td>
                                <td data-label="Distance">@UiHelpers.Km(r.Event.DistanceKm)</td>
                                <td data-label="Enrolments">@r.Enrolments</td>
                                <td data-label="Actions" class="text-end actions">
                                    <a class="btn rd-btn rd-btn--outline-dark rd-btn--sm" asp-action="EditEvent" asp-route-id="@r.Event.EventID">Edit</a>
                                    <a class="btn rd-btn rd-btn--outline-dark rd-btn--sm" asp-action="Categories" asp-route-eventId="@r.Event.EventID">Categories</a>
                                    <form asp-action="DeleteEvent" asp-route-id="@r.Event.EventID" method="post" class="d-inline js-confirm"
                                          data-confirm-title="Delete this event?" data-confirm-message="&quot;@r.Event.Name&quot; and its categories will be removed. This cannot be undone." data-confirm-button="Delete event">
                                        <button type="submit" class="btn rd-btn rd-btn--outline-danger rd-btn--sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
