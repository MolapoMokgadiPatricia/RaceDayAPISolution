@model ResultsVm
@{
    ViewData["Title"] = "Results";
}
<section class="page-head">
    <div class="container rd-container">
        <h1 class="page-title">Results</h1>
        <p class="page-lead">Capture finish times and positions. Saved results are published to each participant's race history.</p>
    </div>
</section>

<section class="section section--tight">
    <div class="container rd-container">
        @if (!Model.Events.Any() || Model.Selected == null)
        {
            <partial name="_NoEvents" />
        }
        else
        {
            <partial name="_EventSelector" model='(Model.Events, Model.Selected, "Results")' />

            @if (Model.NotYetHeld)
            {
                <div class="rd-alert rd-alert--warning" role="status">
                    <span><strong>@Model.Selected.Name</strong> takes place on @Model.Selected.EventDate.ToString("d MMMM yyyy"). Results are normally captured after the event has finished.</span>
                </div>
            }

            @if (!Model.Rows.Any())
            {
                <div class="empty-state empty-state--inline"><p>There are no confirmed or pending participants to capture results for yet.</p></div>
            }
            else
            {
                <form asp-action="SaveResults" method="post" data-validate id="resultsForm">
                    <input type="hidden" name="eventId" value="@Model.Selected.EventID" />

                    <div class="toolbar">
                        <p class="toolbar__hint">Type finish times as <strong>h:mm:ss</strong> (for example 1:35:20). Leave a row empty to skip it.</p>
                        <button type="button" class="btn rd-btn rd-btn--outline-dark" id="autoRank">Rank by finish time</button>
                    </div>

                    <div class="table-responsive">
                        <table class="table rd-table rd-table--entry">
                            <thead><tr><th>Participant</th><th>Category</th><th>Status</th><th>Finish time</th><th>Position</th><th class="text-end"></th></tr></thead>
                            <tbody>
                                @for (int i = 0; i < Model.Rows.Count; i++)
                                {
                                    var r = Model.Rows[i];
                                    <tr>
                                        <td data-label="Participant">
                                            <strong>@r.ParticipantName</strong>
                                            <input type="hidden" name="rows[@i].EnrolmentId" value="@r.EnrolmentId" />
                                            <input type="hidden" name="rows[@i].ResultId" value="@r.ResultId" />
                                            <input type="hidden" name="rows[@i].ParticipantName" value="@r.ParticipantName" />
                                        </td>
                                        <td data-label="Category">@r.CategoryName</td>
                                        <td data-label="Status"><partial name="_StatusBadge" model="r.Status" /></td>
                                        <td data-label="Finish time">
                                            <input name="rows[@i].TimeText" class="form-control rd-input rd-input--sm time-input" inputmode="numeric" placeholder="h:mm:ss" maxlength="8"
                                                   pattern="^\d{1,3}:[0-5]\d(:[0-5]\d)?$" value="@r.TimeText" aria-label="Finish time for @r.ParticipantName" />
                                        </td>
                                        <td data-label="Position">
                                            <input name="rows[@i].Position" type="number" min="1" class="form-control rd-input rd-input--sm position-input" placeholder="1" value="@r.Position" aria-label="Position for @r.ParticipantName" />
                                        </td>
                                        <td class="text-end">
                                            @if (r.ResultId.HasValue)
                                            {
                                                <button type="submit" class="btn rd-btn rd-btn--outline-danger rd-btn--sm"
                                                        formaction="@Url.Action("DeleteResult", "Organiser", new { id = r.ResultId.Value, eventId = Model.Selected.EventID })"
                                                        formnovalidate data-confirm-title="Remove this result?" data-confirm-message="The result for @r.ParticipantName will be removed from their race history." data-confirm-button="Remove result">Remove</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn rd-btn rd-btn--primary rd-btn--lg" data-submit-label="Publishing...">Save and publish results</button>
                    </div>
                </form>
            }
        }
    </div>
</section>
