@model EventListVm
<div class="event-browser" data-event-filters>
    <form class="filter-bar" role="search" aria-label="Filter events" onsubmit="return false">
        <div class="filter-bar__field filter-bar__field--grow">
            <label for="filterSearch">Search</label>
            <input type="search" id="filterSearch" class="form-control rd-input" placeholder="Event name or town" autocomplete="off" data-filter="search" />
        </div>
        <div class="filter-bar__field">
            <label for="filterType">Type</label>
            <select id="filterType" class="form-select rd-input" data-filter="type">
                <option value="">All types</option>
                <option value="run">Run</option>
                <option value="walk">Walk</option>
                <option value="cycle">Cycle</option>
            </select>
        </div>
        <div class="filter-bar__field">
            <label for="filterDistance">Distance</label>
            <select id="filterDistance" class="form-select rd-input" data-filter="distance">
                <option value="">Any distance</option>
                <option value="0-10">Up to 10 km</option>
                <option value="10-21.1">10 to 21 km</option>
                <option value="21.1-42.2">21 to 42 km</option>
                <option value="42.2-9999">Over 42 km</option>
            </select>
        </div>
        <div class="filter-bar__field">
            <label for="filterSort">Sort by</label>
            <select id="filterSort" class="form-select rd-input" data-filter="sort">
                <option value="date">Soonest first</option>
                <option value="distance">Shortest distance</option>
                <option value="name">Name A to Z</option>
            </select>
        </div>
        <div class="filter-bar__field filter-bar__field--check">
            <div class="form-check rd-check">
                <input class="form-check-input" type="checkbox" id="filterPast" data-filter="past" />
                <label class="form-check-label" for="filterPast">Show finished events</label>
            </div>
            <button type="button" class="btn rd-btn rd-btn--link" data-filter-reset>Clear filters</button>
        </div>
    </form>

    <p class="filter-count" aria-live="polite"><span data-filter-count>@Model.UpcomingCount</span> <span data-filter-label>upcoming events</span></p>

    <div class="event-grid" data-event-grid>
        @foreach (var card in Model.Events)
        {
            <partial name="_EventCard" model="card" />
        }
    </div>

    <div class="empty-state" data-filter-empty hidden>
        <h3>No events match those filters</h3>
        <p>Try a different distance or event type, or clear the filters to see everything.</p>
        <button type="button" class="btn rd-btn rd-btn--primary" data-filter-reset>Clear filters</button>
    </div>

    @if (!Model.Events.Any())
    {
        <div class="empty-state">
            <h3>No events yet</h3>
            <p>Organisers are still setting up the next season. Check back soon.</p>
        </div>
    }
</div>
