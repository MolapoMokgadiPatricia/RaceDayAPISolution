<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="rd-header">
        <div class="container rd-container">
            <nav class="navbar navbar-expand-lg rd-navbar">
                <a class="rd-logo" asp-controller="Home" asp-action="Index">
                    RACE<span style="color: var(--brand-pink);">DAY</span>
                </a>

                <button class="navbar-toggler rd-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#rdNav">
                    <span></span><span></span><span></span>
                </button>

                <div class="collapse navbar-collapse" id="rdNav">
                    <ul class="navbar-nav rd-links me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a></li>

                        @if (Context.Session.IsAuthenticated())
                        {
                            @if (Context.Session.IsParticipant())
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Enrolments" asp-action="MyEvents">My Events</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Results" asp-action="MyResults">My Results</a></li>
                            }
                            else if (Context.Session.IsOrganiser())
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Create">Create Event</a></li>
                            }
                        }
                    </ul>

                    <div class="rd-actions">
                        @if (Context.Session.IsAuthenticated())
                        {
                            <a class="rd-user" href="#">
                                <span class="rd-avatar"><i class="bi bi-person-fill"></i></span>
                                <span class="rd-user__text">
                                    <strong>@Context.Session.GetFirstName()</strong>
                                    <small>@Context.Session.GetRole()</small>
                                </span>
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                <button type="submit" class="rd-btn rd-btn--outline rd-btn--sm">
                                    <i class="bi bi-box-arrow-right"></i> Log out
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="rd-btn rd-btn--outline">
                                <i class="bi bi-box-arrow-in-right"></i> Log in
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="rd-btn rd-btn--primary">
                                <i class="bi bi-person-plus-fill"></i> Sign up
                            </a>
                        }
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="rd-footer text-center py-4 mt-auto">
        <div class="container">
            <p class="mb-1 fw-bold" style="font-family: var(--font-display); font-style: italic; font-size: 1.5rem; color: #fff;">
                RACE<span style="color: var(--brand-orange);">DAY</span>
            </p>
            <p class="mb-0 text-muted small">South African road running, walking and cycling events, in one place.</p>
            <p class="mt-3 text-muted small">&copy; @DateTime.Now.Year - PROG6212 Programming 2B</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>