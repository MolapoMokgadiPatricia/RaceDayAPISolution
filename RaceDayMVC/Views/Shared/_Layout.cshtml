@{
    string role = Context.Session.GetString(SessionKeys.Role) ?? string.Empty;
    string fullName = Context.Session.GetString(SessionKeys.FullName) ?? string.Empty;
    bool loggedIn = !string.IsNullOrEmpty(role);
    string controller = (ViewContext.RouteData.Values["controller"] ?? "").ToString()!;
    string action = (ViewContext.RouteData.Values["action"] ?? "").ToString()!;

    string Active(string c, string? a = null) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        (a == null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";

    bool isOrganiserEventPage = controller == "Organiser" && (action == "Events" || action == "CreateEvent" || action == "EditEvent");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] == null ? "RaceDay" : ViewData["Title"] + " · RaceDay")</title>
    <meta name="description" content="RaceDay brings South Africa's road running, walking and cycling events into one place." />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%230a1f44'/%3E%3Cpath d='M14 46 28 18h10L24 46z' fill='%23ff5a1f'/%3E%3Cpath d='M30 46 44 18h8L38 46z' fill='%23c6f03a'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,700;1,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewData["BodyClass"])">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="rd-header">
        <nav class="navbar navbar-expand-lg rd-navbar" aria-label="Main navigation">
            <div class="container rd-container">
                <a class="rd-logo" asp-controller="Home" asp-action="Index" aria-label="RaceDay home">RACE<span>DAY</span></a>

                <button class="navbar-toggler rd-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span></span><span></span><span></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav rd-links me-auto">
                        @if (role == "Organiser")
                        {
                            <li class="nav-item"><a class="nav-link @Active("Organiser", "Dashboard")" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @(isOrganiserEventPage ? "active" : "")" asp-controller="Organiser" asp-action="Events">My events</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Organiser", "Categories")" asp-controller="Organiser" asp-action="Categories">Categories</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Organiser", "Enrolments")" asp-controller="Organiser" asp-action="Enrolments">Enrolments</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Organiser", "Results")" asp-controller="Organiser" asp-action="Results">Results</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Events")" asp-controller="Events" asp-action="Index">Events</a></li>
                            @if (role == "Participant")
                            {
                                <li class="nav-item"><a class="nav-link @Active("Participant", "MyEvents")" asp-controller="Participant" asp-action="MyEvents">My events</a></li>
                                <li class="nav-item"><a class="nav-link @Active("Participant", "MyResults")" asp-controller="Participant" asp-action="MyResults">My results</a></li>
                            }
                        }
                    </ul>

                    <div class="rd-actions">
                        @if (loggedIn)
                        {
                            <a class="rd-user @Active("Account", "Profile")" asp-controller="Account" asp-action="Profile" title="Your profile">
                                <span class="rd-avatar" aria-hidden="true">@UiHelpers.Initials(fullName)</span>
                                <span class="rd-user__text">
                                    <strong>@fullName</strong>
                                    <small>@role</small>
                                </span>
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn rd-btn rd-btn--outline">Log out</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn rd-btn rd-btn--outline" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn rd-btn rd-btn--primary" asp-controller="Account" asp-action="Register">Sign up</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="rd-alerts" aria-live="polite">
        @foreach (var (key, css) in new[] { ("Success", "success"), ("Error", "error"), ("Warning", "warning") })
        {
            if (TempData[key] is string text && !string.IsNullOrWhiteSpace(text))
            {
                <div class="container rd-container">
                    <div class="rd-alert rd-alert--@css" role="@(css == "error" ? "alert" : "status")">
                        <span>@text</span>
                        <button type="button" class="rd-alert__close" aria-label="Dismiss message">&times;</button>
                    </div>
                </div>
            }
        }
    </div>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container rd-container rd-footer__inner">
            <a class="rd-logo rd-logo--small" asp-controller="Home" asp-action="Index">RACE<span>DAY</span></a>
            <p>South African road running, walking and cycling events, in one place.</p>
            <p class="rd-footer__small">PROG6212 Programming 2B · The Independent Institute of Education · @DateTime.Now.Year</p>
        </div>
    </footer>

    <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rd-modal">
                <div class="modal-header">
                    <h2 class="modal-title" id="confirmTitle">Are you sure?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body"><p id="confirmMessage" class="mb-0"></p></div>
                <div class="modal-footer">
                    <button type="button" class="btn rd-btn rd-btn--outline-dark" data-bs-dismiss="modal">Keep it</button>
                    <button type="button" class="btn rd-btn rd-btn--danger" id="confirmAccept">Yes, continue</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
