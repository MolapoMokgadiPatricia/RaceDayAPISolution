@model ErrorVm
@{
    ViewData["Title"] = Model.Title;
}
<section class="section section--center">
    <div class="container rd-container">
        <div class="error-panel">
            <span class="error-panel__code">@(Model.Code == 0 ? "Oops" : Model.Code.ToString())</span>
            <h1>@Model.Title</h1>
            <p>@Model.Message</p>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <a class="btn rd-btn rd-btn--primary" asp-controller="Home" asp-action="Index">Back to home</a>
                <a class="btn rd-btn rd-btn--outline-dark" asp-controller="Events" asp-action="Index">Browse events</a>
            </div>
        </div>
    </div>
</section>
