@* Model: (List<ApiEvent> events, ApiEvent? selected, string action) *@
@model (List<ApiEvent> Events, ApiEvent? Selected, string Action)
<form method="get" asp-controller="Organiser" asp-action="@Model.Action" class="event-selector">
    <label for="eventId" class="rd-label">Event</label>
    <select id="eventId" name="eventId" class="form-select rd-input" data-autosubmit>
        @foreach (var ev in Model.Events)
        {
            <option value="@ev.EventID" selected="@(Model.Selected?.EventID == ev.EventID)">@ev.Name · @ev.EventDate.ToString("d MMM yyyy")</option>
        }
    </select>
    <noscript><button type="submit" class="btn rd-btn rd-btn--primary">Show</button></noscript>
</form>
